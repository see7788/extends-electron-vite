{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "composite": true,
    "types": ["electron-vite/node"]
  },
  "include": ["electron.vite.config.*", "resources/electron-update.ts", "resources/electron-release.ts", "src/main/**/*", "src/preload/**/*"]
}
