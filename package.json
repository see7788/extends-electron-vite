{
  "name": "electron-template",
  "version": "1.0.1",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "dev": "chcp 65001&&tsx node_modules/electron-vite/bin/electron-vite.js dev --watch",
    "build": "tsx node_modules/electron-vite/bin/electron-vite.js build",
    "start": "electron-vite preview",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:preload": "tsc --noEmit -p tsconfig.preload.json --composite false",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:preload && pnpm run typecheck:renderer",
    "concurrentlydemo": "concurrently \"pnpm run electron:dev\" \"pnpm run webrtc:dev\"",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "fs-extra": "11.2.0",
    "lib-vanilla": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "35.1.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.1",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "6.3.5"
  }
}
