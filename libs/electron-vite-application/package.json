{
  "name": "__PACKAGE_NAME__",
  "version": "0.1.0",
  "private": true,
  "tpltype": "electron-vite-application",
  "type": "module",
  "main": "./.dist/out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "build:linux": "pnpm build && electron-builder --config resources/electron-builder.yml --linux",
    "build:mac": "pnpm build && electron-builder --config resources/electron-builder.yml --mac",
    "build:unpack": "pnpm build && electron-builder --config resources/electron-builder.yml --dir",
    "build:win": "pnpm build && electron-builder --config resources/electron-builder.yml --win",
    "dev": "electron-vite dev --watch",
    "postinstall": "electron-builder install-app-deps",
    "release": "tsx resources/electron-release.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "electron-vite-config-lib": "workspace:*",
    "hono": "4.12.30"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "ubuntu-lib": "workspace:*",
    "vite": "^8.0.11"
  }
}
